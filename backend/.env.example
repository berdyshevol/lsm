# PostgreSQL connection string. Production points at Neon; TLS is enabled
# automatically for any host other than localhost.
DATABASE_URL=postgresql://user:password@localhost:5432/lsm
# Schema owning every table this app creates. Production uses a dedicated
# schema because the Neon database is shared with other projects. Defaults to
# public, which is what you want against a local database of your own.
DATABASE_SCHEMA=public
# JWT signing secret (min 16 chars — Render generates via render.yaml)
JWT_SECRET=dev-secret-change-in-production
# Environment: development | production | test
NODE_ENV=development
